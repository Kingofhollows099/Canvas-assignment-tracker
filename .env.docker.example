# Copy to .env for docker-compose:  cp .env.docker.example .env
# Then fill in the values below. Keep this file private — it holds your secrets.

# ---- Web-UI login (REQUIRED when exposed to the internet) ----
# The username and password you'll type to open the tracker in a browser.
APP_USERNAME=changeme

# Either set a plaintext password here (simplest)...
APP_PASSWORD=change-this-to-a-long-passphrase
# ...or, to avoid storing the plaintext, generate a hash and use APP_PASSWORD_HASH
# instead (leave APP_PASSWORD blank if you do):
#   docker compose run --rm tracker python server.py --hash-password
# APP_PASSWORD_HASH=scrypt$...$...

# ---- Userscript sync token (REQUIRED) ----
# The bearer token the Violentmonkey userscript must send. Generate a random one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_TOKEN=paste-a-long-random-token-here

# ---- Optional tuning ----
# SESSION_TTL_SECONDS=604800     # how long a login lasts (default 7 days)
# CANVAS_LOOKBACK_DAYS=14        # how far back overdue work is kept
# CANVAS_HORIZON_DAYS=90         # how far ahead the list reaches
# CACHE_SECONDS=300              # server-side cache window
# COOKIE_SECURE=1                # set 0 ONLY for plain-http local testing
