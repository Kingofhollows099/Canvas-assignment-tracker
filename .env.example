# Copy this file to .env and fill in your values.

# Your school's Canvas address (what you see in the browser when logged in), no trailing slash.
CANVAS_BASE_URL=https://yourschool.instructure.com

# Canvas > Account > Settings > "+ New Access Token"
CANVAS_API_TOKEN=paste-your-token-here

# Optional
# PORT=8000
# HOST=127.0.0.1            # 0.0.0.0 exposes the tracker (and your assignments) to your network
# CANVAS_LOOKBACK_DAYS=14   # how far back to look for overdue work
# CANVAS_HORIZON_DAYS=60    # how far ahead the to-do list reaches
# CACHE_SECONDS=300         # how long to reuse a Canvas response before asking again

# Data source: auto (default), canvas, userscript, or demo.
# "auto" uses Canvas if a token is set, otherwise browser-sync (userscript) mode.
# CANVAS_SOURCE=userscript
# PUSH_STORE_PATH=pushed_assignments.json   # where browser-sync data is kept

# Browser-sync mode encrypts traffic with TLS by default. Override if needed:
# CANVAS_SOURCE=userscript
# (use "python server.py --no-tls" only for local testing without HTTPS)

# Timezone the web UI shows due dates/times in (IANA name). Defaults to America/Chicago.
# DISPLAY_TIMEZONE=America/Chicago
